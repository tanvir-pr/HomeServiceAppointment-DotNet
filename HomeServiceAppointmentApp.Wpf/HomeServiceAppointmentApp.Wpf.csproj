<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Avoid preview SDK (e.g. 10.0.300) writing assets.json that stable 10.0.203 fails to read (ResolvePackageAssets NRE). -->
    <SdkAnalysisLevel>10.0.100</SdkAnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- 5.2.x has a smaller graph than 7.x; avoids some ResolvePackageAssets/LockFile issues with VS SDK combos -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
