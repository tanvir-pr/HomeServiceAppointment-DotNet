<Window x:Class="HomeServiceAppointmentApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home Service Appointment App" Height="640" Width="1000">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="CustomerDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="CustomerDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CustomerId}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Address" Binding="{Binding DefaultAddress}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Name" Margin="0,0,0,4"/>
            <TextBox x:Name="CustomerNameTextBox" Margin="0,0,0,10"/>
            <TextBlock Text="Email" Margin="0,0,0,4"/>
            <TextBox x:Name="CustomerEmailTextBox" Margin="0,0,0,10"/>
            <TextBlock Text="Phone" Margin="0,0,0,4"/>
            <TextBox x:Name="CustomerPhoneTextBox" Margin="0,0,0,10"/>
            <TextBlock Text="Default Address" Margin="0,0,0,4"/>
            <TextBox x:Name="CustomerAddressTextBox" Margin="0,0,0,16"/>
            <Button Content="Refresh" Height="30" Click="RefreshData_Click"/>
        </StackPanel>
    </Grid>
</Window>